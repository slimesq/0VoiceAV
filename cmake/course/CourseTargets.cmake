include("${CMAKE_CURRENT_LIST_DIR}/../VoiceAVDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../VoiceAVHelpers.cmake")

function(voice_av_course_ffmpeg)
    if(TARGET course_ffmpeg)
        return()
    endif()

    set(_release_dependencies "${VOICE_AV_USING_RELEASE_CONAN_DEPS}")
    if(NOT TARGET ffmpeg::ffmpeg)
        voice_av_find_ffmpeg("${VOICE_AV_COURSE_ROOT}" _release_dependencies)
    endif()

    add_library(course_ffmpeg INTERFACE)
    target_include_directories(course_ffmpeg INTERFACE "${VOICE_AV_COURSE_SOURCES}/common")
    target_link_libraries(course_ffmpeg INTERFACE ffmpeg::ffmpeg)
    set_property(TARGET course_ffmpeg PROPERTY VOICE_AV_RELEASE_DEPENDENCIES "${_release_dependencies}")
endfunction()

function(voice_av_course_sdl)
    if(TARGET course_sdl2)
        return()
    endif()

    add_library(course_sdl2 INTERFACE)
    add_library(course_sdl2_main INTERFACE)
    if(VOICE_AV_COURSE_SDL2_ROOT)
        if(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(_arch x64)
        else()
            set(_arch x86)
        endif()
        find_path(_sdl_include SDL.h PATHS "${VOICE_AV_COURSE_SDL2_ROOT}"
            PATH_SUFFIXES include/SDL2 include
            NO_DEFAULT_PATH NO_CACHE REQUIRED)
        find_library(_sdl_library NAMES SDL2 PATHS "${VOICE_AV_COURSE_SDL2_ROOT}"
            PATH_SUFFIXES "lib/${_arch}" lib lib64 NO_DEFAULT_PATH NO_CACHE REQUIRED)
        target_include_directories(course_sdl2 SYSTEM INTERFACE "${_sdl_include}")
        get_filename_component(_sdl_include_parent "${_sdl_include}" DIRECTORY)
        if(EXISTS "${_sdl_include_parent}/SDL2/SDL.h")
            target_include_directories(course_sdl2 SYSTEM INTERFACE "${_sdl_include_parent}")
        endif()
        target_link_libraries(course_sdl2 INTERFACE "${_sdl_library}")
        if(WIN32)
            find_library(_sdl_main NAMES SDL2main PATHS "${VOICE_AV_COURSE_SDL2_ROOT}"
                PATH_SUFFIXES "lib/${_arch}" lib lib64 NO_DEFAULT_PATH NO_CACHE)
            if(_sdl_main)
                target_link_libraries(course_sdl2_main INTERFACE "${_sdl_main}")
            endif()
        endif()
    else()
        find_package(SDL2 QUIET CONFIG)
        if(TARGET SDL2::SDL2)
            target_link_libraries(course_sdl2 INTERFACE SDL2::SDL2)
            if(TARGET SDL2::SDL2main)
                target_link_libraries(course_sdl2_main INTERFACE SDL2::SDL2main)
            endif()
        else()
            find_package(PkgConfig REQUIRED)
            pkg_check_modules(CourseSDL2 REQUIRED IMPORTED_TARGET GLOBAL sdl2)
            target_link_libraries(course_sdl2 INTERFACE PkgConfig::CourseSDL2)
        endif()
    endif()
    target_link_libraries(course_sdl2_main INTERFACE course_sdl2)
endfunction()

function(voice_av_course_dependencies target)
    foreach(_dependency IN LISTS ARGN)
        if(_dependency MATCHES "^FFMPEG(_INTERNAL)?$")
            if(_dependency STREQUAL "FFMPEG_INTERNAL")
                set(_source_version "")
                if(EXISTS "${VOICE_AV_COURSE_FFMPEG_INTERNAL_ROOT}/RELEASE")
                    file(STRINGS "${VOICE_AV_COURSE_FFMPEG_INTERNAL_ROOT}/RELEASE" _source_version LIMIT_COUNT 1)
                endif()
                if(NOT _source_version STREQUAL "7.1.3")
                    message(FATAL_ERROR "${target} needs the FFmpeg 7.1.3 source tree. Run dependency setup or set VOICE_AV_COURSE_FFMPEG_INTERNAL_ROOT.")
                endif()
                target_include_directories(${target} PRIVATE "${VOICE_AV_COURSE_FFMPEG_INTERNAL_ROOT}")
            endif()
            target_link_libraries(${target} PRIVATE course_ffmpeg)
        elseif(_dependency MATCHES "^SDL2(_MAIN)?$")
            voice_av_course_sdl()
            string(TOLOWER "${_dependency}" _sdl_target)
            target_link_libraries(${target} PRIVATE "course_${_sdl_target}")
        elseif(_dependency STREQUAL "THREADS")
            find_package(Threads REQUIRED)
            target_link_libraries(${target} PRIVATE Threads::Threads)
        elseif(_dependency STREQUAL "GLIB")
            find_package(PkgConfig REQUIRED)
            if(NOT TARGET PkgConfig::CourseGLib)
                pkg_check_modules(CourseGLib REQUIRED IMPORTED_TARGET GLOBAL glib-2.0 gthread-2.0)
            endif()
            target_link_libraries(${target} PRIVATE PkgConfig::CourseGLib)
        else()
            message(FATAL_ERROR "Unknown course dependency ${_dependency} for ${target}")
        endif()
    endforeach()
endfunction()

function(voice_av_course_add_qt name project_dir)
    # Each player owns its own Qt-generated headers and Ninja byproducts.
    set(_voice_av_qt_args "${name};${project_dir};${ARGN}")
    add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/qt" "qt/${name}")
endfunction()

function(voice_av_course_add name project_dir)
    voice_av_pad_target_numbers(name "${name}")
    cmake_parse_arguments(PARSE_ARGV 2 COURSE ""
        "C_STANDARD;CXX_STANDARD;KIND"
        "SOURCES;DEPENDENCIES;INCLUDE_DIRS;DEFINITIONS;LIBRARIES;OPTIONS;LINK_OPTIONS;PLATFORMS;COMPILER_IDS")
    if(COURSE_UNPARSED_ARGUMENTS OR COURSE_KEYWORDS_MISSING_VALUES OR NOT COURSE_SOURCES)
        message(FATAL_ERROR "Invalid course target declaration for ${name}: ${COURSE_UNPARSED_ARGUMENTS} ${COURSE_KEYWORDS_MISSING_VALUES}")
    endif()
    get_property(_targets GLOBAL PROPERTY VOICE_AV_COURSE_CATALOG)
    if(name IN_LIST _targets)
        message(FATAL_ERROR "Repeated course target ${name}")
    endif()
    set_property(GLOBAL APPEND PROPERTY VOICE_AV_COURSE_CATALOG "${name}")
    set(_source_dir "${VOICE_AV_COURSE_SOURCES}/${project_dir}")
    set(_sources)
    foreach(_source IN LISTS COURSE_SOURCES)
        cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${_source_dir}")
        if(NOT EXISTS "${_source}")
            message(FATAL_ERROR "${name} references missing source ${_source}")
        endif()
        list(APPEND _sources "${_source}")
    endforeach()

    set(_available TRUE)
    if(COURSE_PLATFORMS AND NOT CMAKE_SYSTEM_NAME IN_LIST COURSE_PLATFORMS)
        set(_available FALSE)
    endif()
    if(COURSE_COMPILER_IDS AND NOT CMAKE_CXX_COMPILER_ID IN_LIST COURSE_COMPILER_IDS)
        set(_available FALSE)
    endif()
    if(_available)
        set_property(GLOBAL APPEND PROPERTY VOICE_AV_COURSE_AVAILABLE "${name}")
    endif()

    set(_selected FALSE)
    foreach(_selector IN LISTS VOICE_AV_COURSE_TARGETS)
        if(_selector MATCHES "^(.*)\\*$")
            string(FIND "${name}" "${CMAKE_MATCH_1}" _prefix_pos)
            if(NOT _prefix_pos EQUAL 0)
                continue()
            endif()
        elseif(NOT name STREQUAL _selector)
            continue()
        endif()
        set_property(GLOBAL APPEND PROPERTY VOICE_AV_COURSE_MATCHED "${_selector}")
        if(_available)
            set(_selected TRUE)
        elseif(name STREQUAL _selector)
            message(FATAL_ERROR "${name} requires platform [${COURSE_PLATFORMS}] and compiler [${COURSE_COMPILER_IDS}]. Empty lists allow any.")
        endif()
    endforeach()
    if(NOT _selected)
        return()
    endif()

    set(_release_dependencies OFF)
    if("FFMPEG" IN_LIST COURSE_DEPENDENCIES OR "FFMPEG_INTERNAL" IN_LIST COURSE_DEPENDENCIES)
        voice_av_course_ffmpeg()
        get_target_property(_release_dependencies course_ffmpeg VOICE_AV_RELEASE_DEPENDENCIES)
    endif()

    # Select Qt's configuration before creating its imported targets.
    if("QT_WIDGETS" IN_LIST COURSE_DEPENDENCIES)
        if(_release_dependencies)
            voice_av_map_release_imports()
        endif()
        # The course players use Qt Widgets without Vulkan.
        set(CMAKE_DISABLE_FIND_PACKAGE_WrapVulkanHeaders TRUE)
        find_package(Qt6 REQUIRED COMPONENTS Widgets)
        set(_qt_widgets Qt6::Widgets)
    endif()
    if(COURSE_KIND)
        add_library(${name} ${COURSE_KIND} ${_sources})
    else()
        add_executable(${name} ${_sources})
        set_property(GLOBAL APPEND PROPERTY VOICE_AV_EXAMPLE_EXECUTABLES "${name}")
    endif()
    if(NOT COURSE_C_STANDARD)
        set(COURSE_C_STANDARD 11)
    endif()
    if(NOT COURSE_CXX_STANDARD)
        set(COURSE_CXX_STANDARD 17)
    endif()
    if(VOICE_AV_RUNTIME_OUTPUT_DIR)
        set(_runtime_dir "${VOICE_AV_RUNTIME_OUTPUT_DIR}")
    else()
        set(_runtime_dir "${CMAKE_BINARY_DIR}/bin/$<CONFIG>")
    endif()
    string(REGEX MATCH "^[^/]+" _chapter "${project_dir}")
    set_target_properties(${name} PROPERTIES
        C_STANDARD "${COURSE_C_STANDARD}" C_STANDARD_REQUIRED ON
        CXX_STANDARD "${COURSE_CXX_STANDARD}" CXX_STANDARD_REQUIRED ON
        FOLDER "voice_av/${_chapter}"
        RUNTIME_OUTPUT_DIRECTORY "${_runtime_dir}")
    if(MSVC)
        target_compile_definitions(${name} PRIVATE _CRT_SECURE_NO_WARNINGS)
        target_compile_options(${name} PRIVATE /utf-8)
        if(_release_dependencies)
            set_property(TARGET ${name} PROPERTY MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
            target_link_options(${name} PRIVATE /IGNORE:4099)
        endif()
    endif()
    voice_av_configure_warnings(${name})
    target_include_directories(${name} PRIVATE "${_source_dir}")
    foreach(_include IN LISTS COURSE_INCLUDE_DIRS)
        if(NOT _include MATCHES "^\\$<")
            cmake_path(ABSOLUTE_PATH _include BASE_DIRECTORY "${_source_dir}")
        endif()
        target_include_directories(${name} PRIVATE "${_include}")
    endforeach()
    target_compile_definitions(${name} PRIVATE ${COURSE_DEFINITIONS})
    target_compile_options(${name} PRIVATE ${COURSE_OPTIONS})
    target_link_options(${name} PRIVATE ${COURSE_LINK_OPTIONS})
    if(_qt_widgets)
        target_link_libraries(${name} PRIVATE "${_qt_widgets}")
        set_target_properties(${name} PROPERTIES
            AUTOMOC ON
            AUTOUIC ON
            AUTOUIC_SEARCH_PATHS "${_source_dir}/src"
            AUTORCC ON
        )
        list(REMOVE_ITEM COURSE_DEPENDENCIES QT_WIDGETS)
    endif()
    voice_av_course_dependencies(${name} ${COURSE_DEPENDENCIES})
    target_link_libraries(${name} PRIVATE ${COURSE_LIBRARIES})
    set_property(GLOBAL APPEND PROPERTY VOICE_AV_COURSE_SELECTED "${name}")
endfunction()
