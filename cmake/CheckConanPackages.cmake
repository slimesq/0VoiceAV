cmake_minimum_required(VERSION 3.22)

if(NOT IS_DIRECTORY "${VOICE_AV_CONAN_GENERATORS_DIR}")
    message(FATAL_ERROR "Conan's generated configuration is missing.")
endif()

file(GLOB _package_data LIST_DIRECTORIES FALSE "${VOICE_AV_CONAN_GENERATORS_DIR}/*-data.cmake")
foreach(_file IN LISTS _package_data)
    include("${_file}")
endforeach()

get_cmake_property(_variables VARIABLES)
set(_package_count 0)
foreach(_variable IN LISTS _variables)
    if(_variable MATCHES "_PACKAGE_FOLDER_[A-Z0-9_]+$")
        set(_package "${${_variable}}")
        if(NOT IS_DIRECTORY "${_package}")
            message(FATAL_ERROR "A Conan package is missing from the local cache: ${_package}")
        endif()

        # Conan records packaged files after a timestamp, one path and checksum per line.
        set(_manifest "${_package}/conanmanifest.txt")
        if(NOT EXISTS "${_manifest}" OR IS_DIRECTORY "${_manifest}")
            message(FATAL_ERROR "A cached Conan package is missing its manifest: ${_manifest}")
        endif()
        file(STRINGS "${_manifest}" _entries ENCODING UTF-8)
        list(POP_FRONT _entries _timestamp)
        if(NOT _timestamp MATCHES "^[0-9]+$" OR NOT _entries)
            message(FATAL_ERROR "Invalid Conan package manifest: ${_manifest}")
        endif()
        foreach(_entry IN LISTS _entries)
            if(NOT _entry MATCHES "^(.+): [0-9a-fA-F]+$")
                message(FATAL_ERROR "Invalid Conan package manifest entry in ${_manifest}: ${_entry}")
            endif()
            set(_path "${_package}/${CMAKE_MATCH_1}")
            if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
                message(FATAL_ERROR "A cached Conan package is missing a file: ${_path}")
            endif()
        endforeach()
        math(EXPR _package_count "${_package_count} + 1")
    endif()
endforeach()
if(_package_count EQUAL 0)
    message(FATAL_ERROR "Conan's generated package paths are missing.")
endif()
