{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Windows desktop examples",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "voice-av-windows-all"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build 09_03 FLV muxer (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "voice-av-windows-all-debug", "--target", "voice_av_09_03_muxing_flv"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure Windows desktop examples",
      "problemMatcher": "$msCompile"
    }
  ]
}
